{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "extension/**"]
    },
    "@reins/web#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../cli/CHANGELOG.md", "../extension/CHANGELOG.md"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "zip": {
      "dependsOn": ["^build"],
      "outputs": ["release/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      // Strict env mode strips undeclared variables: without this the
      // extension's real-browser suite never sees the Chrome CI installed and
      // falls back to whatever /usr/bin/google-chrome the runner image ships.
      "env": ["REINS_TEST_CHROME"]
    }
  }
}
